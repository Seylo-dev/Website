# Port the API listens on.
PORT=4000
# Postgres for telemetry counts and troubleshoot reports. Required in production (the API won't
# start without it): on Easypanel, the Postgres service's internal connection URL, not an exposed
# one. sslmode in the URL is honoured (?sslmode=require). Leave it unset in dev to use SQLite.
# DATABASE_URL=postgres://postgres:password@project_site-db:5432/project
# Folder for the dev SQLite file (site.db), used only when DATABASE_URL is unset.
DATA_DIR=./data
# Public origin report links are built on: <SITE_URL>/l/<id>. The landing page proxies /l/* here.
SITE_URL=https://seylo.dev
# Set to true only when the API is reachable through Cloudflare/Traefik alone.
TRUST_PROXY=false
# Bearer token for GET /telemetry/summary. Leave empty to disable the endpoint.
STATS_TOKEN=
# Where the installer comes from. Defaults to the latest GitHub release of the app repo.
# INSTALLER_RELEASE_URL=https://github.com/Seylo-dev/App/releases/latest/download/install.sh
# INSTALLER_CACHE_SECONDS=300
# Local installer used when the release can't be fetched. Defaults to ../seylo/installer/install.sh
# next to this repo outside production.
# INSTALL_SCRIPT_PATH=

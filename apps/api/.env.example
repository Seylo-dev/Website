# Port the API listens on.
PORT=4000
# Postgres for telemetry counts and troubleshoot reports. Required in production (the API won't
# start without it): on Easypanel, the Postgres service's internal connection URL, not an exposed
# one. sslmode in the URL is honoured (?sslmode=require). Leave it unset in dev to use SQLite.
# DATABASE_URL=postgres://postgres:password@project_site-db:5432/project
# Folder for the dev SQLite file (site.db), used only when DATABASE_URL is unset.
DATA_DIR=./data
# Public origin report links are built on: <SITE_URL>/l/<id>. The landing page redirects /l and /l/* here with a 307.
SITE_URL=https://seylo.dev
# Set to true only when every request reaches the API through a proxy that appends the address
# connecting to it to X-Forwarded-For (Easypanel's Traefik does). Rate limits then key on that last
# hop, or on cf-connecting-ip when the last hop is one of Cloudflare's addresses.
TRUST_PROXY=false
# Bearer token for GET /telemetry/summary. Leave empty to disable the endpoint.
STATS_TOKEN=
# Where the installer comes from: the app repo's releases page. Each check resolves /latest to a
# tag and serves that release's install.sh only when it matches the release's signed manifest
# (the key is brand.json's minisignPublicKey, not a setting).
# INSTALLER_RELEASES_URL=https://github.com/Seylo-dev/App/releases
# INSTALLER_CACHE_SECONDS=300
# Local installer used when the release can't be fetched. Defaults to ../seylo/installer/install.sh
# next to this repo outside production.
# INSTALL_SCRIPT_PATH=
